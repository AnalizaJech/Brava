{
  "name": "brava-leather-commerce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production && node scripts/harden-build.mjs",
    "watch": "ng build --watch --configuration development",
    "build:pages": "ng build --configuration production --base-href /Brava/ && node scripts/harden-build.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
